        "nom_tt_025C_1v80": ["dir::macros/mode_scanner/lib/nom_tt_025C_1v80.lib"]
      },
      "spef": {
        "max_*": ["dir::macros/mode_scanner/spef/max.spef"],
        "min_*": ["dir::macros/mode_scanner/spef/min.spef"],
        "nom_*": ["dir::macros/mode_scanner/spef/nom.spef"]
      },
      "instances": {"u_scanner": {"location": [6.44, 62.56], "orientation": "N"}}
    },
    "mode_lfsr": {
      "gds": ["dir::macros/mode_lfsr/mode_lfsr.gds"],
      "lef": ["dir::macros/mode_lfsr/mode_lfsr.lef"],
      "nl": ["dir::macros/mode_lfsr/mode_lfsr.nl.v"],
      "pnl": ["dir::macros/mode_lfsr/mode_lfsr.pnl.v"],
      "lib": {
        "max_ff_n40C_1v95": ["dir::macros/mode_lfsr/lib/max_ff_n40C_1v95.lib"],
        "max_ss_100C_1v60": ["dir::macros/mode_lfsr/lib/max_ss_100C_1v60.lib"],
        "max_tt_025C_1v80": ["dir::macros/mode_lfsr/lib/max_tt_025C_1v80.lib"],
        "min_ff_n40C_1v95": ["dir::macros/mode_lfsr/lib/min_ff_n40C_1v95.lib"],
        "min_ss_100C_1v60": ["dir::macros/mode_lfsr/lib/min_ss_100C_1v60.lib"],
        "min_tt_025C_1v80": ["dir::macros/mode_lfsr/lib/min_tt_025C_1v80.lib"],
