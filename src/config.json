{
  "//1": "LibreLane configuration for a Tiny Tapeout 1x1 tile with four hardened macros.",
  "//2": "Everything below the DO NOT CHANGE line is the official Tiny Tapeout block, value for value.",
  "//3": "The macro settings are all above that line.",
  "//4": "The Tiny Tapeout tools add DESIGN_NAME, VERILOG_FILES, DIE_AREA, the pin template and RT_MAX_LAYER met4 from info.yaml.",
  "//5": "Paths that start with dir:: are relative to this folder (src/).",

  "//10": "PL_TARGET_DENSITY_PCT - the macros take half the tile, so the glue logic is placed a little denser than the default 60.",
  "PL_TARGET_DENSITY_PCT": 70,

  "//11": "CLOCK_PERIOD - in nanoseconds, so 20ns == 50MHz.",
  "CLOCK_PERIOD": 20,

  "//12": "Hold slack margins.",
  "PL_RESIZER_HOLD_SLACK_MARGIN": 0.1,
  "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.05,

  "RUN_LINTER": 1,
  "LINTER_INCLUDE_PDK_MODELS": 1,

  "CLOCK_PORT": "clk",

  "//20": "MACRO POWER. The tile has only the official vertical met4 straps (no met5). The macros keep off met4 and have their VPWR and VGND pins on met3, so the straps run over them and connect with vias. This variable only names the macro pin layer here: with FP_PDN_MULTILAYER 0 no horizontal straps are made.",
  "FP_PDN_HORIZONTAL_LAYER": "met3",
  "PDN_MACRO_CONNECTIONS": [
    "u_counter VPWR VGND VPWR VGND",
    "u_lfsr VPWR VGND VPWR VGND",
    "u_scanner VPWR VGND VPWR VGND",
    "u_synth VPWR VGND VPWR VGND"
  ],

  "//21": "The met4 straps are 38.87 um apart, VPWR and VGND side by side, starting near x = 19. Every macro is placed so that at least one VPWR and one VGND strap cross it.",

  "//22": "Macro halo, 4 um to the sides. Every row segment beside a macro is either fully cut by overlapping halos or at least 40 um wide, so tap cells always fit. Row segments between 0 and about 20 um get no taps (nwell.4, LU.2, LU.3).",
  "FP_MACRO_HORIZONTAL_HALO": 4,

  "//23": "Above and below only 1.5 um. That keeps the top row (y 106.08 to 108.8) whole across the tile, above the scanner too. The strap pair near x = 19 runs over the synth and the scanner all the way up, and this row is the only place it meets the standard cell rails: without it that pair is cut off from the rest of the power grid (PSM-0069).",
  "FP_MACRO_VERTICAL_HALO": 1.5,
  "FP_PDN_HORIZONTAL_HALO": 2,
  "FP_PDN_VERTICAL_HALO": 1,

  "//24": "Slew repair. The resizer repairs slew at the typical corner; the slow corner (ss, 100C, 1.60 V) is about twice as slow, so it gets a 50% margin. The second repair after global routing catches nets that only appear later, such as the clock tree.",
  "DESIGN_REPAIR_MAX_SLEW_PCT": 50,
  "RUN_POST_GRT_DESIGN_REPAIR": 1,
  "GRT_DESIGN_REPAIR_MAX_SLEW_PCT": 50,

  "//25": "The macros. Their sources and block configs are in blocks/.",
  "MACROS": {
    "mode_synth": {
      "gds": ["dir::macros/mode_synth/mode_synth.gds"],
      "lef": ["dir::macros/mode_synth/mode_synth.lef"],
      "nl": ["dir::macros/mode_synth/mode_synth.nl.v"],
      "pnl": ["dir::macros/mode_synth/mode_synth.pnl.v"],
      "lib": {
        "max_ff_n40C_1v95": ["dir::macros/mode_synth/lib/max_ff_n40C_1v95.lib"],
        "max_ss_100C_1v60": ["dir::macros/mode_synth/lib/max_ss_100C_1v60.lib"],
        "max_tt_025C_1v80": ["dir::macros/mode_synth/lib/max_tt_025C_1v80.lib"],
        "min_ff_n40C_1v95": ["dir::macros/mode_synth/lib/min_ff_n40C_1v95.lib"],
        "min_ss_100C_1v60": ["dir::macros/mode_synth/lib/min_ss_100C_1v60.lib"],
        "min_tt_025C_1v80": ["dir::macros/mode_synth/lib/min_tt_025C_1v80.lib"],
        "nom_ff_n40C_1v95": ["dir::macros/mode_synth/lib/nom_ff_n40C_1v95.lib"],
        "nom_ss_100C_1v60": ["dir::macros/mode_synth/lib/nom_ss_100C_1v60.lib"],
        "nom_tt_025C_1v80": ["dir::macros/mode_synth/lib/nom_tt_025C_1v80.lib"]
      },
      "spef": {
        "max_*": ["dir::macros/mode_synth/spef/max.spef"],
        "min_*": ["dir::macros/mode_synth/spef/min.spef"],
        "nom_*": ["dir::macros/mode_synth/spef/nom.spef"]
      },
      "instances": {"u_synth": {"location": [6.44, 5.44], "orientation": "N"}}
    },
    "mode_counter": {
      "gds": ["dir::macros/mode_counter/mode_counter.gds"],
      "lef": ["dir::macros/mode_counter/mode_counter.lef"],
      "nl": ["dir::macros/mode_counter/mode_counter.nl.v"],
      "pnl": ["dir::macros/mode_counter/mode_counter.pnl.v"],
      "lib": {
        "max_ff_n40C_1v95": ["dir::macros/mode_counter/lib/max_ff_n40C_1v95.lib"],
        "max_ss_100C_1v60": ["dir::macros/mode_counter/lib/max_ss_100C_1v60.lib"],
        "max_tt_025C_1v80": ["dir::macros/mode_counter/lib/max_tt_025C_1v80.lib"],
        "min_ff_n40C_1v95": ["dir::macros/mode_counter/lib/min_ff_n40C_1v95.lib"],
        "min_ss_100C_1v60": ["dir::macros/mode_counter/lib/min_ss_100C_1v60.lib"],
        "min_tt_025C_1v80": ["dir::macros/mode_counter/lib/min_tt_025C_1v80.lib"],
        "nom_ff_n40C_1v95": ["dir::macros/mode_counter/lib/nom_ff_n40C_1v95.lib"],
        "nom_ss_100C_1v60": ["dir::macros/mode_counter/lib/nom_ss_100C_1v60.lib"],
        "nom_tt_025C_1v80": ["dir::macros/mode_counter/lib/nom_tt_025C_1v80.lib"]
      },
      "spef": {
        "max_*": ["dir::macros/mode_counter/spef/max.spef"],
        "min_*": ["dir::macros/mode_counter/spef/min.spef"],
        "nom_*": ["dir::macros/mode_counter/spef/nom.spef"]
      },
      "instances": {"u_counter": {"location": [65.32, 5.44], "orientation": "N"}}
    },
    "mode_scanner": {
      "gds": ["dir::macros/mode_scanner/mode_scanner.gds"],
      "lef": ["dir::macros/mode_scanner/mode_scanner.lef"],
      "nl": ["dir::macros/mode_scanner/mode_scanner.nl.v"],
      "pnl": ["dir::macros/mode_scanner/mode_scanner.pnl.v"],
      "lib": {
        "max_ff_n40C_1v95": ["dir::macros/mode_scanner/lib/max_ff_n40C_1v95.lib"],
        "max_ss_100C_1v60": ["dir::macros/mode_scanner/lib/max_ss_100C_1v60.lib"],
        "max_tt_025C_1v80": ["dir::macros/mode_scanner/lib/max_tt_025C_1v80.lib"],
        "min_ff_n40C_1v95": ["dir::macros/mode_scanner/lib/min_ff_n40C_1v95.lib"],
        "min_ss_100C_1v60": ["dir::macros/mode_scanner/lib/min_ss_100C_1v60.lib"],
