  OBS
      LAYER nwell ;
        RECT 2.570 2.635 42.050 51.765 ;
      LAYER li1 ;
        RECT 2.760 2.635 41.860 51.765 ;
      LAYER met1 ;
        RECT 1.910 2.480 43.630 51.920 ;
      LAYER met2 ;
        RECT 1.930 52.720 9.010 53.000 ;
