VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO mode_counter
  CLASS BLOCK ;
  FOREIGN mode_counter ;
  ORIGIN 0.000 0.000 ;
  SIZE 45.000 BY 55.000 ;
  PIN VGND
    DIRECTION INOUT ;
    USE GROUND ;
    PORT
      LAYER met3 ;
        RECT 2.760 10.220 41.860 11.820 ;
    END
    PORT
      LAYER met3 ;
        RECT 2.760 30.220 41.860 31.820 ;
    END
    PORT
      LAYER met3 ;
        RECT 2.760 50.220 41.860 51.820 ;
    END
  END VGND
  PIN VPWR
